  "metric_definitions": {
    "count_ratio_pct": "layer feature count / truth buildings * 100",
    "area_ratio_pct": "sum(layer polygon area) / sum(truth footprint area) * 100",
    "one2one_coverage_pct": "truth buildings matched 1:1 by a layer polygon / truth buildings * 100",
    "one2one_precision_pct": "layer polygons that are a genuine 1:1 match / all layer polygons * 100",
    "ghost_pct": "layer polygons with no truth building under them / all layer polygons * 100",
    "swallow_max": "max number of truth buildings swallowed by a single layer polygon",
    "shift_median_m": "median centroid distance between matched pairs (metres)"
  },
